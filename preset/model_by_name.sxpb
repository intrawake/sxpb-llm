)
(dono-gpt-oss-120b
  (fullname openrouter/openai/gpt-oss-120b:free)
)
(dono-nemotron3-30a3b
  (fullname openrouter/nvidia/nemotron-3-nano-30b-a3b:free)
)
(dono-nemotron3-120a12b
  (fullname openrouter/nvidia/nemotron-3-super-120b-a12b:free)
)
(dono-nemotron3-550a55b
