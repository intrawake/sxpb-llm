()
;; ── Canonical model definitions for sxpb-llm.
;; Fields (all optional except fullname):
;;   fullname          — model identifier sent to the API
;;   token_ctx_limit   — context window size (default 128000)
;;   token_gen_limit   — max generation tokens (default 16384)
;;   reasoning_effort  — low / medium / high / none
;;   timeout           — HTTP timeout in seconds (0 = wait forever)
;;   <any other key>   — passed as extra kwargs to call_api

;; ── AI Studio (Gemini / Gemma) ──────────────────────────────────────────
(dono-gemini-lite
  (fullname aistudio/gemini-3.1-flash-lite-preview)
)
(dono-gemini-flash
  (fullname aistudio/gemini-3-flash-preview)
)
(dono-gemma3-12b
  (fullname aistudio/gemma-3-12b-it)
)
(dono-gemma3-27b
  (fullname aistudio/gemma-3-27b-it)
)
(dono-gemma4-26a4b
  (fullname aistudio/gemma-4-26b-a4b-it)
)
(dono-gemma4-31b
  (fullname aistudio/gemma-4-31b-it)
)

;; ── Mistral ─────────────────────────────────────────────────────────────
(dono-mistral-small
  (fullname mistral/mistral-small-latest)
)
(dono-mistral-medium
  (fullname mistral/mistral-medium-latest)
)
(dono-mistral-large
  (fullname mistral/mistral-large-latest)
)
(dono-magistral-medium
  (fullname mistral/magistral-medium-latest)
)

